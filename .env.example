# VibeSafe — Frontend environment variables
# Copy this to .env and fill in your values.
# VITE_ prefix = safe to expose to the browser.
# Everything else = server-side only, never reaches the client.

# ── Express scan engine (DigitalOcean droplet) ────────────────────────────────
VITE_API_URL=http://localhost:4000
API_SECRET=changeme

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/vibesafe

